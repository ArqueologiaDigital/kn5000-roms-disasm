rebuilt_ROMs/
part_a.rom
part_b.rom
.claude/

# Python bytecode
__pycache__/
*.pyc

# ASL assembler intermediate files
*.p
*.lst

# Intermediate build artifacts (not in rebuilt_ROMs)
hdae5000/*.rebuilt.bin
hdae5000/*.rebuilt.p
table_data/includes/preset_data.bin
table_data/includes/preset_data.p

# Demo presets: the checked-in source is midi/ + sidecar/. The decompressed .bin
# and its LZSS payload are both generated (see the demo-preset rules in Makefile).
table_data/includes/demo_presets/demo_preset_*.bin

# Test ROM artifacts
test_ROMs/*.bin
test_ROMs/*.p
test_ROMs/*.lst
test_ROMs/*.rom

# LLVM build artifacts (object files, linked binaries)
maincpu/llvm/*.o
maincpu/llvm/*.elf

# Extracted font intermediates (PNGs are in kn5000-docs, PGMs are raw)
extracted_fonts/*.pgm
extracted_fonts/*.png

# Generated binary blobs (compiled from C, .incbin'd by assembly)
maincpu/includes/generated/*.bin

# Cruft and temporary files
cruft_please_ignore/
mame_driver/build_error.txt
*/maincpu/includes/generated/*.bin
