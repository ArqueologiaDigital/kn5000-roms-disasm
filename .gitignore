rebuilt_ROMs/
part_a.rom
part_b.rom
.claude/

# Python bytecode
__pycache__/
*.pyc

# ASL assembler intermediate files
*.p
*.lst

# Intermediate build artifacts (not in rebuilt_ROMs)
hdae5000/*.rebuilt.bin
hdae5000/*.rebuilt.p
table_data/includes/preset_data.bin
table_data/includes/preset_data.p

# Demo presets: the checked-in source is midi/ + sidecar/. The decompressed .bin
# and its LZSS payload are both generated (see the demo-preset rules in Makefile).
table_data/includes/demo_presets/demo_preset_*.bin

# Help databases: the checked-in source is the decompressed help_db_<lang>.bin;
# the SLIDE8K payload is generated (see the help-database rules in Makefile).
table_data/includes/help_databases/help_db_*_compressed.bin

# The table_data stale-remnant duplicate (style_records.s + help_databases.s): derived
# byte-for-byte from help_db_english_compressed.bin + help_db_german_compressed.bin by
# scripts/generators/gen_stale_help_duplicate.py -- see that script's header.
table_data/includes/help_databases/stale_style_records_residue.bin
table_data/includes/help_databases/stale_help_db_german_head.bin

# Test ROM artifacts
test_ROMs/*.bin
test_ROMs/*.p
test_ROMs/*.lst
test_ROMs/*.rom

# LLVM build artifacts (object files, linked binaries)
maincpu/llvm/*.o
maincpu/llvm/*.elf

# Extracted font intermediates (PNGs are in kn5000-docs, PGMs are raw)
extracted_fonts/*.pgm
extracted_fonts/*.png

# Generated binary blobs (compiled from C, .incbin'd by assembly)
maincpu/includes/generated/*.bin

# Cruft and temporary files
cruft_please_ignore/
mame_driver/build_error.txt
*/maincpu/includes/generated/*.bin
hdae5000/includes/generated/*.bin
table_data/includes/generated/*.bin
custom_data/includes/section_*.bin

# v10 data-as-code census: regenerable analysis cache (16 MB+), rebuilt by
# `python3 scripts/analysis/v10_data_as_code_census.py --census --fresh`
notes/v10-data-as-code/cache.pkl

# v10dac2_line_probe.py's address->(file,line) map (lane V10DAC2, 2026-09-02):
# regenerable in ~10s by `python3 scripts/analysis/v10dac2_line_probe.py --build`
notes/v10-data-as-code/line_probe_cache.json

# v7tabletail_line_probe.py's address->(file,line) map (lane V7TABLETAIL,
# 2026-09-02): 18 MB+, regenerable in well under a minute by
# `python3 scripts/analysis/v7tabletail_line_probe.py --build`
notes/v7-table-tail-32/line_probe_cache.json

# v9_v10_undisassembled_census.py scratch work directory (a full v7/v9/v10
# copy plus rebuilt ROMs/ELFs/pickles -- several hundred MB, regenerate with
# --prepare, never commit)
island-work/
# census_one_image.py's default single-image scratch dir (same regenerable
# nature as island-work/ above, just scoped to one tag): rebuild with
# `python3 scripts/analysis/census_one_image.py v7`, never commit.
census-work/
