	.equ MIDI_RX_Flags,				0x009e	; its flags; bit 6 = first data byte pending (cleared with bit 1 by and 0xBD) -- the 0xFA5942 banner
	.equ MIDI_RX_SysExState,			0x00a9	; its SysEx state -- the 0xFA5942 banner; MIDI_RX_SysEx*
